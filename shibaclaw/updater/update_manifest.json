{
    "version": "1.1.5",
    "release_notes": "Security release: update pypdf, pyasn1, langgraph, and langgraph-sdk to resolve Dependabot alerts #73–#85.",
    "changes": [
        {
            "path": "pyproject.toml",
            "overwrite": true,
            "note": "Require patched pypdf and set v1.1.5."
        },
        {
            "path": "uv.lock",
            "overwrite": true,
            "note": "Lock patched pypdf, pyasn1, langgraph and langgraph-sdk."
        },
        {
            "path": "CHANGELOG.md",
            "overwrite": true,
            "note": "Document the security release."
        },
        {
            "path": "shibaclaw/updater/update_manifest.json",
            "overwrite": true,
            "note": "Publish the v1.1.5 updater manifest."
        },
        {
            "path": "update_manifest.json",
            "overwrite": true,
            "note": "Synchronize the root updater manifest."
        },
        {
            "path": "shibaclaw/desktop/app.manifest",
            "overwrite": true,
            "note": "Set the Windows application identity to v1.1.5."
        },
        {
            "path": "shibaclaw/webui/package.json",
            "overwrite": true,
            "note": "Set the WebUI package version to v1.1.5."
        },
        {
            "path": "shibaclaw/webui/package-lock.json",
            "overwrite": true,
            "note": "Synchronize WebUI package metadata."
        }
    ]
}
